{
  "version": 1,
  "baseUrl": "http://127.0.0.1:4173",
  "coverage": {
    "summaryFile": "artifacts/coverage/coverage-summary.json",
    "thresholds": {
      "lines": 85,
      "statements": 85,
      "functions": 85,
      "branches": 75
    }
  },
  "security": {
    "npmAuditLevel": "high",
    "staticSeverity": {
      "high": 7,
      "critical": 9
    },
    "trivySeverity": ["HIGH", "CRITICAL"],
    "ignoreUnfixed": true
  },
  "lighthouse": {
    "enabled": true,
    "urls": ["/", "/about", "/login"],
    "numberOfRuns": 2,
    "categoryThresholds": {
      "performance": 0.9,
      "accessibility": 0.9,
      "best-practices": 0.9,
      "seo": 0.9
    },
    "metricBudgets": {
      "first-contentful-paint": 1800,
      "largest-contentful-paint": 2500,
      "total-blocking-time": 200,
      "cumulative-layout-shift": 0.1,
      "speed-index": 3000,
      "total-byte-weight": 300000
    }
  }
}
