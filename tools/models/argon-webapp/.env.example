# Google Vertex AI project used by the transient Argon/Carbon tool.
# This is NOT a credential.
GOOGLE_CLOUD_PROJECT=

# Google Cloud region for Vertex AI.
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: use Gemini API-key mode instead of Vertex/ADC.
# Leave empty when using Google Application Default Credentials.
GEMINI_API_KEY=

# Optional local wrapper settings.
ARGON_WEBAPP_REF=main
ARGON_WEBAPP_RUNTIME_DIR=
