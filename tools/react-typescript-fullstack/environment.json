{
  "id": "javascript.typescript.fullstack.react",
  "version": 3,
  "runtime": {"node": "22", "packageManagers": ["npm", "pnpm", "yarn"], "browser": "chromium"},
  "detection": {"required": ["package.json"], "signals": ["react", "typescript", "vite", "next", "react-scripts"]},
  "toolchain": {
    "packageManifest": "tools/react-typescript-fullstack/package.json",
    "installation": "npm install --prefix tools/react-typescript-fullstack --ignore-scripts",
    "tools": [
      {"name":"TypeScript","package":"typescript","version":"6.0.3","purpose":"static type checking; compatible with typescript-eslint 8.72.0"},
      {"name":"ESLint","package":"eslint","version":"10.14.0","purpose":"config-driven linting"},
      {"name":"typescript-eslint","package":"typescript-eslint","version":"8.72.0","purpose":"TypeScript-aware ESLint rules"},
      {"name":"Prettier","package":"prettier","version":"3.9.10","purpose":"format verification"},
      {"name":"Biome","package":"@biomejs/biome","version":"2.6.4","purpose":"fast lint and format"},
      {"name":"Vitest","package":"vitest","version":"5.0.5","purpose":"unit and component tests"},
      {"name":"Playwright","package":"playwright","version":"1.64.1","purpose":"real-browser end-to-end inspection"},
      {"name":"axe-core","package":"@axe-core/playwright","version":"4.14.0","purpose":"automated accessibility audit"},
      {"name":"Knip","package":"knip","version":"6.43.0","purpose":"unused files, exports and dependencies"},
      {"name":"dependency-cruiser","package":"dependency-cruiser","version":"18.7.0","purpose":"dependency-boundary and cycle checks"}
    ]
  },
  "browserTests": {
    "manifest": ".agent-workspace/browser-tests.json",
    "routeDiscovery": ["Next.js App Router", "Next.js Pages Router"],
    "workflows": ["navigate", "click", "fill", "check", "uncheck", "selectOption", "expectVisible", "expectHidden", "expectText", "expectUrl", "expectEnabled"],
    "evidence": ["Playwright JSON report", "trace", "screenshots", "DOM snapshots", "console errors", "page errors", "request failures", "HTTP errors", "axe violations", "route coverage"],
    "visualBaselines": "target-local; update only when UPDATE_VISUAL_BASELINES=1"
  },
  "commands": {
    "installTarget": "runner/react-project.py prepare --project-path <path>",
    "quality": "node tools/react-typescript-fullstack/scripts/quality-check-flat.mjs",
    "start": "runner/react-project.py start --project-path <path>",
    "inspect": "node tools/react-typescript-fullstack/scripts/inspect-browser.mjs"
  },
  "inspection": {"capture": ["screenshots","DOM text snapshot","console errors","uncaught page errors","failed requests","HTTP errors","Playwright trace","axe accessibility violations"]},
  "evidence": "artifacts/"
}
